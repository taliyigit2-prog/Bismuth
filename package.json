{
  "name": "bismuth",
  "productName": "Bismuth",
  "version": "0.1.0",
  "private": true,
  "description": "Bismuth — küçük ve orta oteller için masaüstü otel yönetim programı",
  "main": "./out/main/index.js",
  "author": "Bismuth",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc-node.tsbuildinfo -p tsconfig.node.json && tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc-web.tsbuildinfo -p tsconfig.web.json && tsc --noEmit --incremental --tsBuildInfoFile .cache/tsc-e2e.tsbuildinfo -p tsconfig.e2e.json",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project node --coverage",
    "check": "node scripts/check.mjs",
    "e2e": "playwright test --project=electron",
    "e2e:mobile": "playwright test --project=mobile",
    "ui:shot": "electron-vite build && node scripts/ui-shot.mjs",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "db:generate": "drizzle-kit generate",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:add": "node scripts/i18n-add.mjs",
    "notices": "node scripts/notices.mjs",
    "camera:bundle": "node scripts/camera-bundle.mjs",
    "icon": "node scripts/make-icon.mjs",
    "seed:demo": "tsx --tsconfig tsconfig.node.json scripts/seed-demo.ts",
    "guide:docs": "tsx --tsconfig tsconfig.node.json scripts/guide-docs.ts",
    "guide:shots": "electron-vite build && node scripts/guide-shots.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.3",
    "@hookform/resolvers": "5.9.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "bonjour-service": "1.4.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-holidays": "3.37.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "electron-log": "5.4.4",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "exceljs": "4.4.0",
    "globals": "17.13.0",
    "hono": "4.13.12",
    "i18n-iso-countries": "7.14.0",
    "i18next": "26.4.2",
    "jsdom": "30.1.1",
    "lucide-react": "1.49.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "uqr": "0.1.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
