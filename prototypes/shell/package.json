{
  "name": "bismuth-shell-proto",
  "private": true,
  "version": "0.0.1",
  "description": "Faz 0 · A0.1 — packaging spike: Electron + better-sqlite3 + CSS feature check (not product code)",
  "main": "main.cjs",
  "author": "Bismuth",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.bismuth.hotel.proto",
    "productName": "Bismuth Proto",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "index.html", "package.json"],
    "asar": true,
    "asarUnpack": ["node_modules/better-sqlite3/**"],
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "${productName}-Setup-${version}-electron${env.ELECTRON_LINE}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "installerLanguages": ["tr_TR", "en_US", "ru_RU"],
      "multiLanguageInstaller": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-electron${env.ELECTRON_LINE}-${arch}.${ext}"
    },
    "dmg": { "sign": false }
  }
}
