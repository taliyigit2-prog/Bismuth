# otel-kamera ornek ayar dosyasi. Kopyalayin: cp .env.example .env  (.env depoya girmez)
# Kamera: 0 = bilgisayar kamerasi, ya da RTSP adresi (kullanici adi ve sifreyi .env icinde kendiniz yazin)
CAMERA_SOURCE=0
CAMERA_LOCATION=Merdiven / Kat Girisi
# Yuz tanima esikleri
FACE_SIMILARITY_THRESHOLD=0.36
MIN_FACE_DET_SCORE=0.62
MIN_FACE_SIZE_PX=55
CONFIRMATION_FRAMES=3
PROCESS_EVERY_N_FRAMES=3
ALARM_COOLDOWN_SECONDS=60
# Telegram (bos birakilirsa yalnizca yerel kayit tutulur)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Depolama
DB_PATH=hotel_guests.db
ALERTS_DIR=alerts
GUEST_PHOTOS_DIR=guest_photos
ALERT_RETENTION_DAYS=30
MAX_ALERT_COUNT=500
DEDUP_SIMILARITY_THRESHOLD=0.46
DEDUP_WINDOW_HOURS=12
# Web paneli (127.0.0.1 = yalnizca bu bilgisayar; 0.0.0.0 YAPMAYIN, panelde sifre yok)
WEB_HOST=127.0.0.1
WEB_PORT=8000
INSIGHTFACE_MODEL_NAME=buffalo_s
# Istege bagli gecis bolgesi (piksel): x1,y1;x2,y2;x3,y3;x4,y4
ZONE_POLYGON=
