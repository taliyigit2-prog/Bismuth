{
  // GitHub Codespaces / Dev Container for Bismuth.
  "name": "Bismuth",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  // Native modules (better-sqlite3, Electron) and the Electron e2e tests need these on Linux.
  "postCreateCommand": "sudo dpkg --add-architecture i386 && sudo apt-get update && sudo apt-get install -y --no-install-recommends xvfb xauth libgtk-3-0 libnss3 libasound2t64 libxss1 git-lfs wine64 wine32:i386 && npm ci --no-audit --no-fund && npx playwright install --with-deps chromium",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
