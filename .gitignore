# dependencies / build
node_modules/
# a worktree may link the main checkout's dependencies
/node_modules
/out/
/dist/
/release/
# Tauri prototype (P22c): build output and generated files stay out; Cargo.lock is committed
shell-tauri/src-tauri/target/
shell-tauri/src-tauri/gen/
shell-tauri/sidecar/dist/
.vite/

# local data — never commit a database or backups
*.db
*.db-wal
*.db-shm
*.sqlite
backups/
.demo/

# secrets and per-developer overrides
.env
.env.*
# sır içermeyen örnek ayar dosyası depoya girer
!otel-kamera/.env.example
.claude/settings.local.json
CLAUDE.local.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test artifacts
coverage/
playwright-report/
test-results/

# Claude hook marker (last successful npm run check)
.claude/.checks-passed
# local Electron profile used by e2e/ui-shot
.tmp/
.eslintcache
# incremental type-check state (npm run typecheck)
.cache/

# agent worktrees (local only)
.claude/worktrees/

# parallel agents: i18n spec files are merged with npm run i18n:add, never committed
/i18n-spec/
graphify-out/

# Otel Kamera - kisisel veri ve sirlar
otel-kamera/.env
otel-kamera/*.db
otel-kamera/guest_photos/
otel-kamera/alerts/
otel-kamera/*.pt
# Kamera model agirliklari (K-57, yasak 14): resources/camera/models icine yalniz README.md ve SHA256SUMS girer
resources/camera/models/*
!resources/camera/models/README.md
!resources/camera/models/SHA256SUMS
otel-kamera/models/

# agent runner logs and session state
tools/ajan/kayit/

# Kamera eki uretim ciktisi (scripts/camera-bundle.mjs): agirliklar ve tekerlekler depoya girmez
camera-addon-out/

# Obsidian vault settings (local to each person)
.obsidian/
