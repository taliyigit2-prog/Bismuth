{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["21st"],
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test *)",
      "Bash(npx vitest *)",
      "Read(./docs/**)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run e2e*)",
      "Bash(npm run ui:shot*)",
      "Bash(npx playwright *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.db)",
      "Read(./**/*.sqlite)",
      "Read(./otel-kamera/guest_photos/**)",
      "Read(./otel-kamera/alerts/**)",
      "Read(./**/*.npy)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/db-migration-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Migrasyon değişmezliği kontrol ediliyor"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"",
            "timeout": 10,
            "statusMessage": "Korumalı dosya kontrolü"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git tag *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/camera-data-guard.mjs\"",
            "timeout": 20,
            "statusMessage": "Kamera/biyometrik veri kontrolü"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/camera-data-guard.mjs\"",
            "timeout": 20,
            "statusMessage": "Kamera/biyometrik veri kontrolü"
          },
          {
            "type": "command",
            "if": "Bash(git add *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/kbs-data-guard.mjs\"",
            "timeout": 20,
            "statusMessage": "Kimlik/KBS verisi kontrolü"
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/kbs-data-guard.mjs\"",
            "timeout": 20,
            "statusMessage": "Kimlik/KBS verisi kontrolü"
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.mjs\"",
            "timeout": 600,
            "statusMessage": "Commit öncesi typecheck + lint + test"
          },
          {
            "type": "command",
            "if": "Bash(npm install *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deps-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(npm i *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deps-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(pnpm add *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deps-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-network-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/i18n-literal-warn.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
